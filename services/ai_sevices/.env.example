# ai-storage-service (FastAPI AI & Scanner Service) Environment Variables Example
PORT=5002

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated allow-list. Also this service's CSRF defense (no separate
# CSRF token — see docs/security.md), so '*' is rejected outright in
# production (ENVIRONMENT=production): list explicit origins there.

# ── Auth verification (public key only) ──
# Must be byte-for-byte the SAME key/issuer/audience as auth-service's
# signing config — this service verifies every request's JWT LOCALLY (see
# app/core/security.py), with no network call back to auth-service. A
# mismatch here silently makes every token look invalid on this service only
# (main-service and the frontend would still accept it fine), which is a
# confusing failure mode to debug — double check this matches
# services/auth-service/.env exactly.
JWT_PUBLIC_KEY_
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=patchlinex
# Optional: during a key rotation on auth-service, copy the OLD public key
# here (see services/auth-service/.env.example for the full rotation
# procedure). Lets this service keep accepting tokens signed under the old
# key until they naturally expire, instead of erroring on all of them the
# instant auth-service switches keys.
# JWT_PREVIOUS_PUBLIC_KEY_BASE64=

# Shared secret main-service attaches to every proxied/scanner call
# (x-internal-service-token header) — must match INTERNAL_SERVICE_TOKEN in
# services/main-service/.env exactly. Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=change_me_internal_token

# ── Azure AI Foundry Configuration ──
AI_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/
# NOTE: must be AZURE_OPENAI_API_KEY (not AZURE_OPENAI_KEY) to match config.py
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Fallback deployment used by any tier below that's left blank
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# ── Scanner cost-tiered deployments ──
# scan:   runs over every file in every scan -> cheapest capable model
AZURE_OPENAI_DEPLOYMENT_SCAN=gpt-4.1-mini
# fix:    generates the actual patch, once per approved finding
AZURE_OPENAI_DEPLOYMENT_FIX=gpt-5.2
# verify: code-specialized recheck of the generated patch (secondary signal
# only — the primary/authoritative verification is a deterministic rescan
# with zero model cost; see app/routers/scanner.py: _rescan_verify_fix)
AZURE_OPENAI_DEPLOYMENT_VERIFY=gpt-5.3-codex

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=scan

# Databases
MONGODB_URI=mongodb://localhost:27017
# Kept in its own database from auth-service's MONGODB_DATABASE (auth_db) so
# scan history/findings data is isolated from user/session data even when
# both point at the same MongoDB instance.
MONGODB_DATABASE=ai_storage_db
REDIS_URL=redis://localhost:6379

# ── Elasticsearch / Elastic Cloud (optional — powers full-text finding search) ──
# If omitted, search transparently falls back to MongoDB regex scanning.
#
# ── Elasticsearch (optional — search degrades gracefully if unset) ──
# Set direct endpoint URL (ES_ENDPOINT or ES_URL) + optional authentication.
#ES_ENDPOINT=http://localhost:9200
#ES_URL=http://localhost:9200
#ES_API_KEY=
#ES_USERNAME=elastic
#ES_PASSWORD=changeme


# ── RAG memory (Remember step) — app/core/memory_store.py ──
# Semantic retrieval of past findings/fixes at fix-generation time. Vectors
# + their metadata are stored in a Chroma Cloud collection (see
# app/core/chroma_client.py) — sign up at trychroma.com, create a database,
# and copy its API key/tenant/database from the dashboard's Connect panel.
# Leave everything below unset to run with EMBEDDING_PROVIDER=mock
# (zero-dependency, deterministic hash vectors — exercises the full
# index -> retrieve -> augment path with no API key, but isn't semantically
# meaningful; see app/services/embeddings.py) and RAG memory effectively
# disabled (indexing/retrieval no-op without CHROMA_API_KEY).
# RAG_MEMORY_ENABLED=true
# EMBEDDING_PROVIDER=azure_openai
# Separate deployment from the chat tiers above — an embedding model, e.g.
# text-embedding-3-small. Reuses AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY.
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Chroma Cloud — required whenever RAG_MEMORY_ENABLED is true.
# CHROMA_API_KEY=ck-...
# Optional: only needed if your API key isn't scoped to a single database —
# otherwise CloudClient resolves both from the key automatically.
# CHROMA_TENANT=
# CHROMA_DATABASE=
# CHROMA_COLLECTION=finding_memory

# ── SAST engine (Semgrep) ──
# The deterministic scanner's primary, AST-based engine (app/services/
# scanning/semgrep_engine.py). Defaults below are safe out of the box: the
# local rule pack committed at semgrep-rules/patchlinex-rules.yml, no network
# dependency at scan time.
# SEMGREP_ENABLED=true
# SEMGREP_BINARY=semgrep
# SEMGREP_CONFIG_PATH=semgrep-rules/patchlinex-rules.yml
# Optional: layer Semgrep Registry rulesets on top for broader coverage —
# this DOES call out to registry.semgrep.dev on every scan, so only set it
# if that network dependency is acceptable for this deployment.
# SEMGREP_EXTRA_CONFIGS=p/security-audit,p/secrets
# SEMGREP_TIMEOUT_SECONDS=60
# SEMGREP_MAX_TARGET_BYTES=2000000

# ── Isolated execution sandbox (app/services/sandbox/) ──
# Third verification signal at fix time: the patched file is actually
# compiled/executed in a resource-limited, non-root, ephemeral subprocess
# (Python and JavaScript today — see app/services/sandbox/runners.py).
# Additive and best-effort: disabling this just removes the signal, the
# existing deterministic-rescan + AI-review verification is unaffected.
# SANDBOX_EXECUTION_ENABLED=true
# SANDBOX_CPU_SECONDS=10
# SANDBOX_MEMORY_MB=256
# SANDBOX_TIMEOUT_SECONDS=20

# Sandbox execution backend: "process" (default, above) or "kubernetes"
# (each execution gets its own ephemeral Job/Pod — see k8s/sandbox/).
# SANDBOX_BACKEND=process
# SANDBOX_K8S_NAMESPACE=patchlinex-sandbox
# SANDBOX_K8S_SERVICE_ACCOUNT=patchlinex-sandbox-runner
# SANDBOX_K8S_KUBECONFIG_PATH=            # unset in-cluster; set for local kind/minikube testing
# SANDBOX_K8S_IMAGE_PYTHON=ghcr.io/patchlinex/sandbox-python-runner:latest
# SANDBOX_K8S_IMAGE_JAVASCRIPT=ghcr.io/patchlinex/sandbox-javascript-runner:latest
# SANDBOX_K8S_CPU_LIMIT=1
# SANDBOX_K8S_MEMORY_LIMIT=512Mi
# SANDBOX_K8S_EPHEMERAL_STORAGE_LIMIT=256Mi
# SANDBOX_K8S_STARTUP_TIMEOUT_SECONDS=45
# SANDBOX_K8S_JOB_TTL_SECONDS=120
