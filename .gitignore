# ══════════════════════════════════════════════════════════════
#  LaunchpadX — root .gitignore
#  Covers: Node.js services, Python/FastAPI (ai_sevices),
#          Next.js frontend, Docker, OS & editor artifacts
# ══════════════════════════════════════════════════════════════

# ── Secrets & environment variables ─────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example files — they're safe templates for new devs
!.env.example

# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnp
.pnp.js
.yarn/

# ── Next.js (frontend) ──────────────────────────────────────
frontend/.next/
frontend/out/
frontend/.vercel

# ── Python / FastAPI (ai_sevices) ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
myenv/
venv/
env/
.venv/
ENV/
.env/

# Python build artifacts
*.egg-info/
dist/
build/
*.egg
*.whl
MANIFEST

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# mypy / pyright
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.pytype/

# ── Testing ──────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Build outputs ────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# ── Docker (local overrides) ─────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ── OS artifacts ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editors & IDEs ───────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
.turbo/
