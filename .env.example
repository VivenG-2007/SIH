# Root Environment Configuration Example
# This is a reference/overview only — each service reads its OWN .env file
# (services/auth-service/.env, services/main-service/.env,
# services/ai-storage-service/.env, frontend/.env.local). Copy the relevant
# values into those, not into a single root .env.
#
# NOTE: ports and callback URLs below match what the services actually use
# (auth-service :5000, main-service :5001, ai-storage-service :5002,
# frontend :3000). See docs/deployment.md for the full list per service.

# --- Global / Deployment ---
NODE_ENV=development

# --- Azure AI Foundry / OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-azure-foundry-openai.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=scans

# --- Databases ---
MONGODB_URI=mongodb://localhost:27017/hackathon_platform
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Auth (auth-service issues; main-service & ai-storage-service verify) ---
# Generate with: npm --prefix services/auth-service run generate-keys
JWT_PRIVATE_KEY_BASE64=your_jwt_private_key_base64_encoded
JWT_PUBLIC_KEY_BASE64=your_jwt_public_key_base64_encoded
# These four values (issuer/audience/keys) must be IDENTICAL across
# auth-service, main-service, ai-storage-service, and frontend/.env.local —
# see the per-service .env.example files for exactly which var goes where.
# A mismatch on any one of them is the #1 cause of "invalid token" errors.
JWT_ISSUER=hackathon-auth-service
JWT_AUDIENCE=patchlinex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_KID=key-1

# Shared secret main-service attaches to every call it forwards to
# ai-storage-service (x-internal-service-token header). Generate with:
# openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=change_me_internal_token

# Encrypts stored GitHub/Jira OAuth tokens at rest. Generate with:
# openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY_BASE64=your_32_byte_key_base64_encoded

# --- Integrations: GitHub OAuth App (per-user connect, not app-wide) ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5001/api/github/oauth/callback
GITHUB_SCOPES=read:user user:email repo

# --- Integrations: Jira OAuth 2.0 / 3LO (per-user connect) ---
JIRA_CLIENT_ID=your_jira_client_id
JIRA_CLIENT_SECRET=your_jira_client_secret
JIRA_REDIRECT_URI=http://localhost:5001/api/jira/oauth/callback
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user offline_access
JIRA_PROJECT_KEY=HACK
JIRA_ISSUE_TYPE=Task

# --- Firecrawl Web Scraping Engine ---
# Powers automated live scraping and verified citations for CRQ & regulatory evidence
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# --- Service Communication URLs & Ports ---
FRONTEND_URL=http://localhost:3000

# auth-service: PORT 5000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:5000

# main-service: PORT 5001
NEXT_PUBLIC_MAIN_API_URL=http://localhost:5001

# ai-storage-service: PORT 5002 (reached through main-service's /api/proxy/*
# from the browser — this var is only used server-to-server)
AI_STORAGE_SERVICE_URL=http://localhost:5002

